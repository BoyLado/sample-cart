{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #ReturnsSection-{{ section.id }} .returns__header {
    text-align: center;
    max-width: 70rem;
    margin: 0 auto 3rem;
  }
  #ReturnsSection-{{ section.id }} .returns__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 1.2rem;
    font-weight: 500;
    margin: 0 0 1rem;
    opacity: 0.75;
  }
  #ReturnsSection-{{ section.id }} .returns__title {
    margin: 0 0 1.2rem;
  }
  #ReturnsSection-{{ section.id }} .returns__intro {
    opacity: 0.85;
    margin: 0;
  }

  #ReturnsSection-{{ section.id }} .returns__panel {
    max-width: 70rem;
    margin: 0 auto;
    padding: 3rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.12);
    border-radius: var(--border-radius, 8px);
    background: rgb(var(--color-background));
  }
  #ReturnsSection-{{ section.id }} .returns__panel[hidden] { display: none; }
  @media screen and (max-width: 749px) {
    #ReturnsSection-{{ section.id }} .returns__panel { padding: 2rem 1.5rem; }
  }

  #ReturnsSection-{{ section.id }} .returns__panel-heading {
    margin: 0 0 2rem;
    font-size: calc(var(--font-heading-scale) * 1.8rem);
  }

  #ReturnsSection-{{ section.id }} .returns__form { margin: 0; }
  #ReturnsSection-{{ section.id }} .returns__field {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 1.8rem;
  }
  #ReturnsSection-{{ section.id }} .returns__field label {
    font-size: 1.4rem;
    font-weight: 500;
  }
  #ReturnsSection-{{ section.id }} .returns__field input {
    width: 100%;
    padding: 1.2rem 1.4rem;
    font-family: inherit;
    font-size: 1.5rem;
    color: rgb(var(--color-foreground));
    background: rgb(var(--color-background));
    border: 0.1rem solid rgba(var(--color-foreground), 0.25);
    border-radius: var(--border-radius, 8px);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  #ReturnsSection-{{ section.id }} .returns__field input:focus {
    outline: none;
    border-color: rgba(var(--color-foreground), 0.6);
    box-shadow: 0 0 0 0.2rem rgba(var(--color-foreground), 0.15);
  }
  #ReturnsSection-{{ section.id }} .returns__field input.is-error,
  #ReturnsSection-{{ section.id }} .returns__reason-select.is-error {
    border-color: #c62828;
    box-shadow: 0 0 0 0.2rem rgba(198, 40, 40, 0.15);
  }
  #ReturnsSection-{{ section.id }} .returns__error {
    margin: 0;
    font-size: 1.3rem;
    color: #c62828;
  }

  #ReturnsSection-{{ section.id }} .returns__button {
    width: 100%;
    margin-top: 0.5rem;
  }
  @media screen and (min-width: 750px) {
    #ReturnsSection-{{ section.id }} .returns__button { width: auto; min-width: 22rem; }
  }

  #ReturnsSection-{{ section.id }} .returns__note {
    margin: 2rem 0 0;
    font-size: 1.3rem;
    opacity: 0.8;
    text-align: center;
  }
  #ReturnsSection-{{ section.id }} .returns__note a {
    color: currentColor;
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }

  #ReturnsSection-{{ section.id }} .returns__order-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }
  #ReturnsSection-{{ section.id }} .returns__order-header h2 {
    margin: 0;
    font-size: calc(var(--font-heading-scale) * 1.8rem);
  }
  #ReturnsSection-{{ section.id }} .returns__badge {
    display: inline-block;
    padding: 0.3rem 1rem;
    font-size: 1.2rem;
    font-weight: 500;
    text-transform: capitalize;
    border-radius: 99rem;
    background: rgba(var(--color-foreground), 0.08);
  }
  #ReturnsSection-{{ section.id }} .returns__order-meta {
    margin: 0 0 2rem;
    font-size: 1.3rem;
    opacity: 0.75;
  }

  #ReturnsSection-{{ section.id }} .returns__section-label {
    margin: 0 0 1rem;
    font-size: 1.3rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.7;
  }

  #ReturnsSection-{{ section.id }} .returns__items {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  #ReturnsSection-{{ section.id }} .returns__item {
    display: grid;
    grid-template-columns: auto 6.4rem 1fr;
    gap: 1.4rem;
    align-items: flex-start;
    padding: 1.4rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.15);
    border-radius: var(--border-radius, 8px);
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  #ReturnsSection-{{ section.id }} .returns__item:hover {
    border-color: rgba(var(--color-foreground), 0.35);
  }
  #ReturnsSection-{{ section.id }} .returns__item.is-selected {
    border-color: rgba(var(--color-foreground), 0.55);
    background: rgba(var(--color-foreground), 0.03);
  }

  #ReturnsSection-{{ section.id }} .returns__item-check {
    margin: 0.4rem 0 0;
    width: 1.8rem;
    height: 1.8rem;
    accent-color: rgb(var(--color-foreground));
    cursor: pointer;
  }

  #ReturnsSection-{{ section.id }} .returns__item-image {
    display: block;
    width: 6.4rem;
    height: 6.4rem;
    border-radius: calc(var(--border-radius, 8px) / 2);
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.06);
  }
  #ReturnsSection-{{ section.id }} .returns__item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #ReturnsSection-{{ section.id }} .returns__item-info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }
  #ReturnsSection-{{ section.id }} .returns__item-title {
    font-size: 1.5rem;
    font-weight: 500;
  }
  #ReturnsSection-{{ section.id }} .returns__item-variant {
    font-size: 1.3rem;
    opacity: 0.7;
  }
  #ReturnsSection-{{ section.id }} .returns__item-price {
    font-size: 1.4rem;
    margin-top: 0.3rem;
  }
  #ReturnsSection-{{ section.id }} .returns__item-qty {
    opacity: 0.65;
  }
  #ReturnsSection-{{ section.id }} .returns__item-reason {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 0.1rem dashed rgba(var(--color-foreground), 0.2);
  }
  #ReturnsSection-{{ section.id }} .returns__item-reason[hidden] { display: none; }
  #ReturnsSection-{{ section.id }} .returns__reason-label {
    font-size: 1.3rem;
    font-weight: 500;
    opacity: 0.85;
  }
  #ReturnsSection-{{ section.id }} .returns__reason-select {
    width: 100%;
    padding: 1rem 1.2rem;
    font-family: inherit;
    font-size: 1.4rem;
    color: rgb(var(--color-foreground));
    background: rgb(var(--color-background));
    border: 0.1rem solid rgba(var(--color-foreground), 0.25);
    border-radius: var(--border-radius, 8px);
  }
  #ReturnsSection-{{ section.id }} .returns__reason-select:focus {
    outline: none;
    border-color: rgba(var(--color-foreground), 0.6);
    box-shadow: 0 0 0 0.2rem rgba(var(--color-foreground), 0.15);
  }

  #ReturnsSection-{{ section.id }} .returns__empty {
    padding: 2rem;
    text-align: center;
    font-size: 1.4rem;
    opacity: 0.8;
    border: 0.1rem dashed rgba(var(--color-foreground), 0.25);
    border-radius: var(--border-radius, 8px);
  }

  #ReturnsSection-{{ section.id }} .returns__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.4rem;
    margin-top: 2.4rem;
    padding-top: 2rem;
    border-top: 0.1rem solid rgba(var(--color-foreground), 0.12);
  }
  #ReturnsSection-{{ section.id }} .returns__selected-count {
    margin: 0;
    font-size: 1.3rem;
    opacity: 0.75;
  }
  #ReturnsSection-{{ section.id }} .returns__actions-buttons {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  #ReturnsSection-{{ section.id }} .returns__link {
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    font-size: 1.4rem;
    color: currentColor;
    text-decoration: underline;
    text-underline-offset: 0.3rem;
    cursor: pointer;
    opacity: 0.85;
  }
  #ReturnsSection-{{ section.id }} .returns__link:hover { opacity: 1; }

  #ReturnsSection-{{ section.id }} .returns__confirmation {
    text-align: center;
  }
  #ReturnsSection-{{ section.id }} .returns__check {
    width: 6.4rem;
    height: 6.4rem;
    margin: 0 auto 1.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(var(--color-foreground), 0.08);
  }
  #ReturnsSection-{{ section.id }} .returns__check svg {
    width: 3.2rem;
    height: 3.2rem;
    stroke: rgb(var(--color-foreground));
  }
  #ReturnsSection-{{ section.id }} .returns__confirmation h2 {
    margin: 0 0 1rem;
    font-size: calc(var(--font-heading-scale) * 1.8rem);
  }
  #ReturnsSection-{{ section.id }} .returns__confirmation p {
    margin: 0 auto 1rem;
    max-width: 50rem;
    font-size: 1.4rem;
    opacity: 0.9;
  }
  #ReturnsSection-{{ section.id }} .returns__order-ref {
    font-weight: 500;
    margin-bottom: 2rem;
  }

  #ReturnsSection-{{ section.id }} .returns__secondary-link {
    display: block;
    text-align: center;
    margin-top: 2.5rem;
    font-size: 1.3rem;
    color: currentColor;
    text-decoration: underline;
    text-underline-offset: 0.3rem;
    opacity: 0.8;
  }
  #ReturnsSection-{{ section.id }} .returns__secondary-link:hover { opacity: 1; }

  #ReturnsSection-{{ section.id }} button[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }
{%- endstyle -%}

<section
  id="ReturnsSection-{{ section.id }}"
  class="returns color-{{ section.settings.color_scheme }} gradient"
  aria-labelledby="ReturnsTitle-{{ section.id }}"
  data-order-service
  data-proxy-base="{{ section.settings.proxy_base | default: '/apps/portal-1' }}"
  data-endpoint-path="{{ section.settings.endpoint_path | default: '/return/status' }}"
  data-currency="{{ cart.currency.symbol | default: '$' }}"
>
  <div class="page-width section-{{ section.id }}-padding">
    <header class="returns__header">
      {% if section.settings.eyebrow != blank %}
        <p class="returns__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h1 id="ReturnsTitle-{{ section.id }}" class="returns__title">
        {{ section.settings.heading | escape }}
      </h1>
      {% if section.settings.intro != blank %}
        <div class="returns__intro rte">{{ section.settings.intro }}</div>
      {% endif %}
    </header>

    <!-- ===== VIEW: lookup form ===== -->
    <div class="returns__panel" data-view="lookup">
      <h2 class="returns__panel-heading">{{ section.settings.panel_heading | escape }}</h2>

      <form class="returns__form" data-lookup-form novalidate>
        <input type="hidden" name="intent" value="lookup">

        <div class="returns__field">
          <label for="ReturnOrderNumber-{{ section.id }}">Order number</label>
          <input
            id="ReturnOrderNumber-{{ section.id }}"
            type="text"
            name="order_number"
            placeholder="#1001"
            autocomplete="off"
            required
          >
          <p class="returns__error" data-error-for="order_number" hidden></p>
        </div>

        <div class="returns__field">
          <label for="ReturnEmail-{{ section.id }}">Checkout email</label>
          <input
            id="ReturnEmail-{{ section.id }}"
            type="email"
            name="email"
            placeholder="you@example.com"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            required
          >
          <p class="returns__error" data-error-for="email" hidden></p>
        </div>

        <button class="button returns__button" type="submit" data-submit>
          {{ section.settings.button_label | escape }}
        </button>
      </form>

      {% if section.settings.note != blank %}
        <p class="returns__note">
          {{ section.settings.note | escape }}
          <a href="/policies/refund-policy">View our return policy</a>
        </p>
      {% endif %}
    </div>

    <!-- ===== VIEW: returnable items ===== -->
    <div class="returns__panel" data-view="items" hidden>
      <div class="returns__order-header">
        <h2>Order <span data-order-number></span></h2>
        <span class="returns__badge" data-order-status></span>
      </div>
      <p class="returns__order-meta" data-order-meta></p>

      <p class="returns__section-label">Select items to return</p>
      <div class="returns__items" data-items></div>

      <p class="returns__empty" data-items-empty hidden>
        Wala pong eligible items for return sa order na ito.
      </p>

      <div class="returns__actions">
        <p class="returns__selected-count" data-selected-count>0 items selected</p>
        <div class="returns__actions-buttons">
          <button class="button" type="button" data-submit-return disabled>
            Submit return request
          </button>
          <button class="returns__link" type="button" data-back>
            Back to lookup
          </button>
        </div>
      </div>
    </div>

    <!-- ===== VIEW: confirmation ===== -->
    <div class="returns__panel returns__confirmation" data-view="confirmation" hidden>
      <div class="returns__check" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      <h2>Return request submitted</h2>
      <p>
        Salamat! Natanggap na namin ang return request mo. Our team will review it and send a confirmation email with return instructions once approved.
      </p>
      <p class="returns__order-ref" data-confirm-ref></p>
      <button class="returns__link" type="button" data-restart>
        Start another return
      </button>
    </div>

    <a class="returns__secondary-link" href="/pages/track-order">
      Looking for your order status?
    </a>
  </div>
</section>

<script>
(function () {
  var root = document.querySelector('[data-order-service]');
  if (!root) return;

  var PROXY_BASE = (root.dataset.proxyBase || '/apps/portal-1').replace(/\/+$/, '');
  var ENDPOINT_PATH = (root.dataset.endpointPath || '/return/status').replace(/^\/+/, '');
  var ENDPOINT = PROXY_BASE + '/' + ENDPOINT_PATH;
  var CURRENCY = root.dataset.currency || '$';

  var REASONS = [
    'Doesn\u2019t fit',
    'Not as described',
    'Changed my mind',
    'Damaged / defective',
    'Wrong item received',
    'Other'
  ];

  var views = {
    lookup:       root.querySelector('[data-view="lookup"]'),
    items:        root.querySelector('[data-view="items"]'),
    confirmation: root.querySelector('[data-view="confirmation"]')
  };
  var lookupForm      = root.querySelector('[data-lookup-form]');
  var itemsContainer  = root.querySelector('[data-items]');
  var itemsEmpty      = root.querySelector('[data-items-empty]');
  var submitReturnBtn = root.querySelector('[data-submit-return]');
  var backBtn         = root.querySelector('[data-back]');
  var restartBtn      = root.querySelector('[data-restart]');
  var selectedCountEl = root.querySelector('[data-selected-count]');
  var confirmRefEl    = root.querySelector('[data-confirm-ref]');

  var currentOrder = null;

  function showView(name) {
    Object.keys(views).forEach(function (k) {
      views[k].hidden = (k !== name);
    });
  }

  /* ---------------------------------------------------------
     LOOKUP — order number + email
     --------------------------------------------------------- */
  lookupForm.addEventListener('submit', function (e) {
    e.preventDefault();
    clearErrors();

    var orderNumber = lookupForm.order_number.value.trim();
    var email       = lookupForm.email.value.trim();
    var valid = true;

    if (!orderNumber) { showError('order_number', 'Please enter your order number.'); valid = false; }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showError('email', 'Please enter a valid email address.'); valid = false;
    }
    if (!valid) return;

    setLoading(lookupForm, true);

    fetch(ENDPOINT, {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({
        intent: 'lookup',
        orderNumber: orderNumber,   /* camelCase — matches backend */
        email: email
      })
    })
    .then(function (r) {
      return r.json().then(function (data) { return { ok: r.ok, data: data }; });
    })
    .then(function (res) {
      /* backend now returns { ok: true, order } or { ok: false, error } */
      if (!res.ok || !res.data || res.data.ok !== true) {
        var msg = (res.data && res.data.error) || 'We could not find that order. Please check your details.';
        showError('order_number', msg);
        return;
      }
      currentOrder = res.data.order;
      renderItems(currentOrder);
    })
    .catch(function (err) {
      console.error(err);
      showError('order_number', 'Something went wrong. Please try again.');
    })
    .finally(function () {
      setLoading(lookupForm, false);
    });
  });

  /* ---------------------------------------------------------
     RENDER — returnable items
     --------------------------------------------------------- */
  function renderItems(order) {
    var numberEl = root.querySelector('[data-order-number]');
    var statusEl = root.querySelector('[data-order-status]');
    var metaEl   = root.querySelector('[data-order-meta]');

    numberEl.textContent = order.number || '';
    statusEl.textContent = order.fulfillmentStatus || '';
    statusEl.dataset.status = String(order.fulfillmentStatus || '').toLowerCase();

    var metaParts = [];
    if (order.createdAt) {
      try {
        metaParts.push(new Date(order.createdAt).toLocaleDateString());
      } catch (e) {
        metaParts.push(order.createdAt);
      }
    }
    if (order.financialStatus) metaParts.push(order.financialStatus);
    metaEl.textContent = metaParts.join(' \u00B7 ');

    itemsContainer.innerHTML = '';
    var items = (order.items || []).filter(function (i) { return i.eligible !== false; });

    if (!items.length) {
      itemsEmpty.hidden = false;
    } else {
      itemsEmpty.hidden = true;
      items.forEach(function (item, idx) {
        itemsContainer.appendChild(buildItemRow(item, idx));
      });
    }

    selectedCountEl.textContent = '0 items selected';
    submitReturnBtn.disabled = true;
    submitReturnBtn.textContent = 'Submit return request';

    showView('items');
    views.items.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function buildItemRow(item, idx) {
    var row = document.createElement('label');
    row.className = 'returns__item';

    /* item.image is { url, alt } | null */
    var imgUrl = item.image && item.image.url ? item.image.url : '';
    var imgAlt = item.image && item.image.alt ? item.image.alt : (item.title || '');

    var imgHtml = imgUrl
      ? '<img src="' + escapeAttr(imgUrl) + '" alt="' + escapeAttr(imgAlt) + '" loading="lazy">'
      : '<span class="returns__item-img-fallback" aria-hidden="true"></span>';

    var reasonOptions = ['<option value="">Select a reason\u2026</option>']
      .concat(REASONS.map(function (r) {
        return '<option value="' + escapeAttr(r) + '">' + escapeHtml(r) + '</option>';
      }))
      .join('');

    /* item.unitPrice is { amount, currency } | null */
    var priceAmount = item.unitPrice && item.unitPrice.amount
      ? Number(item.unitPrice.amount)
      : 0;

    row.innerHTML =
      '<input type="checkbox" class="returns__item-check" data-idx="' + idx + '">' +
      '<span class="returns__item-image">' + imgHtml + '</span>' +
      '<span class="returns__item-info">' +
        '<span class="returns__item-title">' + escapeHtml(item.title || '') + '</span>' +
        '<span class="returns__item-price">' +
          formatPrice(priceAmount) +
          (item.quantity > 1
            ? ' <span class="returns__item-qty">\u00B7 Qty ' + item.quantity + '</span>'
            : '') +
        '</span>' +
        '<span class="returns__item-reason" hidden>' +
          '<span class="returns__reason-label">Reason for return</span>' +
          '<select class="returns__reason-select" data-idx="' + idx + '">' +
            reasonOptions +
          '</select>' +
        '</span>' +
      '</span>';

    row.querySelector('input[type="checkbox"]').addEventListener('change', onSelectionChange);
    row.querySelector('select').addEventListener('change', onSelectionChange);
    return row;
  }

  function onSelectionChange() {
    var count = 0;
    itemsContainer.querySelectorAll('.returns__item').forEach(function (row) {
      var cb     = row.querySelector('input[type="checkbox"]');
      var reason = row.querySelector('.returns__item-reason');
      if (cb.checked) {
        count++;
        reason.hidden = false;
        row.classList.add('is-selected');
      } else {
        reason.hidden = true;
        row.classList.remove('is-selected');
        var sel = row.querySelector('select');
        if (sel) { sel.value = ''; sel.classList.remove('is-error'); }
      }
    });
    selectedCountEl.textContent = count === 1 ? '1 item selected' : count + ' items selected';
    submitReturnBtn.disabled = count === 0;
  }

  /* ---------------------------------------------------------
     SUBMIT — send return request
     --------------------------------------------------------- */
  submitReturnBtn.addEventListener('click', function () {
    if (!currentOrder) return;

    var payloadItems = [];
    var missingReason = false;

    itemsContainer.querySelectorAll('.returns__item').forEach(function (row) {
      var cb = row.querySelector('input[type="checkbox"]');
      if (!cb.checked) return;
      var idx  = cb.dataset.idx;
      var item = currentOrder.items[idx];
      var sel  = row.querySelector('select');

      if (!sel.value) {
        missingReason = true;
        sel.classList.add('is-error');
        return;
      }
      sel.classList.remove('is-error');
      payloadItems.push({
        item_id:  item.id,
        title:    item.title,
        quantity: item.quantity,
        reason:   sel.value
      });
    });

    if (missingReason) {
      alert('Please select a reason for each item you want to return.');
      return;
    }
    if (!payloadItems.length) return;

    var originalLabel = submitReturnBtn.textContent;
    submitReturnBtn.disabled = true;
    submitReturnBtn.textContent = 'Submitting\u2026';

    fetch(ENDPOINT, {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({
        intent: 'submit',
        orderNumber: currentOrder.number,   /* camelCase */
        email: currentOrder.email || lookupForm.email.value.trim(),
        items: payloadItems
      })
    })
    .then(function (r) {
      return r.json().then(function (data) { return { ok: r.ok, data: data }; });
    })
    .then(function (res) {
      if (!res.ok || !res.data || res.data.ok !== true) {
        throw new Error((res.data && res.data.error) || 'Submit failed. Please try again.');
      }
      confirmRefEl.textContent = 'Order ' + currentOrder.number;
      showView('confirmation');
      views.confirmation.scrollIntoView({ behavior: 'smooth', block: 'start' });
    })
    .catch(function (err) {
      console.error(err);
      alert(err.message || 'Something went wrong. Please try again.');
      submitReturnBtn.disabled = false;
      submitReturnBtn.textContent = originalLabel;
    });
  });

  /* ---------------------------------------------------------
     BACK / RESTART
     --------------------------------------------------------- */
  backBtn.addEventListener('click', function () {
    showView('lookup');
    views.lookup.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  restartBtn.addEventListener('click', function () {
    lookupForm.reset();
    clearErrors();
    currentOrder = null;
    itemsContainer.innerHTML = '';
    showView('lookup');
    views.lookup.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  /* ---------------------------------------------------------
     Helpers
     --------------------------------------------------------- */
  function setLoading(form, loading) {
    var btn = form.querySelector('button[type="submit"]');
    if (!btn) return;
    if (!btn.dataset.label) btn.dataset.label = btn.textContent;
    btn.disabled = loading;
    btn.textContent = loading ? 'Searching\u2026' : btn.dataset.label;
  }

  function showError(field, msg) {
    var errEl = root.querySelector('[data-error-for="' + field + '"]');
    if (errEl) { errEl.textContent = msg; errEl.hidden = false; }
    var input = root.querySelector('[name="' + field + '"]');
    if (input) input.classList.add('is-error');
  }

  function clearErrors() {
    root.querySelectorAll('.returns__error').forEach(function (el) {
      el.textContent = ''; el.hidden = true;
    });
    root.querySelectorAll('.is-error').forEach(function (el) {
      el.classList.remove('is-error');
    });
  }

  function formatPrice(v) {
    var n = Number(v) || 0;
    return CURRENCY + n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  function escapeHtml(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
  function escapeAttr(s) { return escapeHtml(s); }
})();
</script>

